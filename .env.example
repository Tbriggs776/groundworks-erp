# =====================================================================
# Groundworks — environment variables
# Copy to `.env.local` for local dev. Never commit `.env.local`.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase — same values in local AND production
# ---------------------------------------------------------------------
# From Supabase dashboard: Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the client. Bypasses RLS — used for
# privileged server work (background jobs, admin scripts). In Vercel,
# mark this variable as "Sensitive" so it's not visible in the UI.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ---------------------------------------------------------------------
# Database — Drizzle runtime client
# ---------------------------------------------------------------------
#
# IMPORTANT: which URL to use depends on the environment.
#
# LOCAL DEV:
#   Direct connection is fine (simpler, no pooler limits matter at scale 1):
#   postgresql://postgres:PASSWORD@db.YOUR-REF.supabase.co:5432/postgres
#
# PRODUCTION (Vercel, any serverless host):
#   MUST use the Supabase Transaction pooler URL. Serverless functions
#   open new DB connections per request and will exhaust the direct
#   connection pool fast. Get it from Supabase → Connect → Transaction pooler:
#   postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# ON VERCEL WITH THE SUPABASE INTEGRATION:
#   You do NOT need to set DATABASE_URL. The integration auto-provisions
#   `POSTGRES_URL` (pooled) which our Drizzle client reads as a fallback.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-REF.supabase.co:5432/postgres


# ---------------------------------------------------------------------
# Migrations — LOCAL ONLY, never set in Vercel
# ---------------------------------------------------------------------
# drizzle-kit and scripts/migrate.ts need a direct (session-mode) connection
# so they can take advisory locks. The pooler's transaction mode doesn't
# support those locks. Port 5432.
#
# Migrations run from your laptop, not from Vercel. Do NOT add this var to
# your Vercel project.
DATABASE_URL_MIGRATE=postgresql://postgres:PASSWORD@db.YOUR-REF.supabase.co:5432/postgres


# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
# The public URL the app is served from. Locally: http://localhost:3000
# On Vercel: https://your-project.vercel.app (or your custom domain).
# Used in invite links and the MCP / API connection snippets.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for the daily cron (recurring entries, auto-reversals,
# pruning of idempotency keys, rate-limit windows, and old sessions). Vercel Cron sends it as a bearer token when set
# on the project. Without it the cron endpoint refuses every call.
CRON_SECRET=generate-a-long-random-string


# ---------------------------------------------------------------------
# Email (invitations, and documents and reminders companies send)
# ---------------------------------------------------------------------
# Resend (https://resend.com) API key and a From address on a verified
# domain. Companies' emails use this address under their own name, with
# replies going to the company. Leave unset in local dev: invites then
# show a link to copy, and document emails are refused.
RESEND_API_KEY=
EMAIL_FROM="Groundworks <team@your-domain.com>"
# Delivery tracking: the signing secret of a Resend webhook pointed at
# https://<app>/api/webhooks/resend (events: delivered, delivery delayed,
# bounced, complained, opened). Unset: sends are logged without status.
RESEND_WEBHOOK_SECRET=


# ---------------------------------------------------------------------
# QuickBooks Online import (optional)
# ---------------------------------------------------------------------
# Your Intuit app's keys (developer.intuit.com). Register the redirect URI
# <NEXT_PUBLIC_APP_URL>/api/qbo/callback in the app. QBO_ENVIRONMENT is
# sandbox (default) or production. Without the keys, the import button
# says QuickBooks isn't set up.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
# Seals secrets the app must read back (QuickBooks and bank feed tokens):
# 32 random bytes, base64. Generate with: openssl rand -base64 32. Changing
# it makes stored tokens unreadable, so every QuickBooks connection and bank
# feed has to reconnect.
APP_ENCRYPTION_KEY=


# ---------------------------------------------------------------------
# Bank feeds through Plaid (optional)
# ---------------------------------------------------------------------
# Your Plaid team's keys (dashboard.plaid.com), with the Transactions
# product. PLAID_ENV is sandbox (default) or production. Webhooks go to
# <NEXT_PUBLIC_APP_URL>/api/webhooks/plaid. For banks that sign in with
# OAuth, register <NEXT_PUBLIC_APP_URL>/banking/feeds as an allowed
# redirect URI in Plaid and set PLAID_REDIRECT_URI to it. Without the keys,
# the Bank Feeds page says feeds aren't set up. Needs APP_ENCRYPTION_KEY.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=


# ---------------------------------------------------------------------
# Sign-in options (optional)
# ---------------------------------------------------------------------
# Extra OAuth buttons on sign-in / sign-up. Enable each provider in
# Supabase → Authentication → Providers first. Values: google, azure, github
NEXT_PUBLIC_AUTH_PROVIDERS=
# "1" shows "Sign in with SSO" (SAML, configured per domain in Supabase).
NEXT_PUBLIC_AUTH_SSO=


# ---------------------------------------------------------------------
# API
# ---------------------------------------------------------------------
# Requests per minute per API key (REST + MCP). Default 600.
API_RATE_LIMIT_PER_MINUTE=

# ---------------------------------------------------------------------
# Groundworks support access
# ---------------------------------------------------------------------
# Profile ids (Supabase Auth user ids) of your support team, comma
# separated. They can open a customer's workspace only while its owner has
# turned support access on (Workspace → Security), read-only, with
# two-step verification in the session. Leave empty for nobody.
GROUNDWORKS_SUPPORT_USER_IDS=
